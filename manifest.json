{
  "manifest_version": 3,
  "name": "PICKCAT Plus",
  "version": "2.6.0",
  "description": "更好的 PICKCAT 社区体验！",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://pickcat.dao3.fun/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://pickcat.dao3.fun/*"
      ],
      "js": [
        "editor.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://pickcat.dao3.fun/*"
      ],
      "js": [
        "suite/core.js",
        "suite/shell.js",
        "suite/winui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts allow-forms allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval'; connect-src 'none'; child-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'self' blob:; img-src data: blob:; media-src 'none'; font-src data:; style-src 'unsafe-inline'; form-action 'none'; base-uri 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "cursors/*",
        "icons/*",
        "sandbox.html",
        "sandbox.js",
        "workshop/*",
        "workshop/packs/*",
        "suite/*.css"
      ],
      "matches": [
        "https://pickcat.dao3.fun/*"
      ]
    }
  ]
}
